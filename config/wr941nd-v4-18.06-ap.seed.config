# PRAGMATIC AP seed for OpenWRT 18.06 -> TL-WR941ND v4 (ar71xx / tiny).
#
# Lesson learned the hard way: removing kernel-level packages (iptables/firewall
# -> netfilter kmods) churns the kernel VERMAGIC and, in an already-built tree,
# desyncs the kernel package from opkg's install set -> "Cannot satisfy ...
# kernel (= <hash>)" at package/install. So here we DO NOT touch any kmod: the
# kernel config stays byte-identical to the stock-equivalent build (which builds
# reliably), and we only trim USERSPACE daemons the AP does not need. firewall /
# iptables / ppp stay installed but inactive; AP behaviour is set via config.
#
# Identical to the stock-equivalent seed ...
CONFIG_TARGET_ar71xx=y
CONFIG_TARGET_ar71xx_tiny=y
CONFIG_TARGET_ar71xx_tiny_DEVICE_tl-wr941nd-v4=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_kmod-ipt-raw=m

# ... minus two userspace-only daemons (no kmod deps -> kernel config unchanged):
# No local DHCP server / DNS (the upstream ASUS router handles this):
# CONFIG_PACKAGE_dnsmasq is not set
# No IPv6 DHCP server:
# CONFIG_PACKAGE_odhcpd-ipv6only is not set
