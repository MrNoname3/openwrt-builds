# Seed config for OpenWRT 18.06 -> TL-WR941ND v4 (ar71xx / tiny subtarget).
#
# This is a SEED: `make defconfig` expands it into a full .config. The bare
# device profile alone does NOT include the LuCI web UI, but the official
# 18.06.9 release image does -- so we explicitly add the `luci` meta-package
# (pulls luci-base, luci-mod-admin-full, luci-theme-bootstrap, uhttpd, rpcd,
# lua, ...) to reproduce the stock file set. Verified by unsquashfs diff:
# without LuCI our rootfs was ~347 KB / 343 files smaller than stock.
CONFIG_TARGET_ar71xx=y
CONFIG_TARGET_ar71xx_tiny=y
CONFIG_TARGET_ar71xx_tiny_DEVICE_tl-wr941nd-v4=y

# Web interface (LuCI) -- the piece the bare profile omits but the stock image ships.
CONFIG_PACKAGE_luci=y

# Match the stock image's xt_CT.ko: the official buildbot builds the whole target,
# so kmod-ipt-raw gets built -> CONFIG_IP_NF_RAW=m in the (shared) kernel config ->
# this satisfies the dependency of the netfilter "CT" target, so xt_CT.ko is built
# and shipped inside kmod-ipt-conntrack (a default package). We build kmod-ipt-raw
# as a module (=m) so it lands in the package feed, NOT the image -- exactly like
# stock (which ships xt_CT.ko but NOT iptable_raw.ko).
CONFIG_PACKAGE_kmod-ipt-raw=m
