# Seed config for OpenWRT 18.06 -> TL-WR941ND v4 (ar71xx / tiny subtarget).
#
# This is only a SEED: `make defconfig` expands it into a full .config with the
# default package set for the profile, which is exactly what the official
# 18.06.9 factory image was built from. Do NOT hand-add packages here for the
# phase-1 reproduction; use `make menuconfig` later (phase 2) to strip packages.
CONFIG_TARGET_ar71xx=y
CONFIG_TARGET_ar71xx_tiny=y
CONFIG_TARGET_ar71xx_tiny_DEVICE_tl-wr941nd-v4=y
