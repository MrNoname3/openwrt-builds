# Seed config for OpenWRT 25.12 -> custom 16MB TL-WR941ND v4 (ath79 / tiny).
#
# Requires the 64MB RAM mod: kernel 6.12 does not run on the stock 32MB.
#
# No zram: with 64MB the RAM is ample, and on the 400MHz CPU swap-in stalls
# hit timing-critical hostapd pages.
CONFIG_TARGET_ath79=y
CONFIG_TARGET_ath79_tiny=y
CONFIG_TARGET_ath79_tiny_DEVICE_tplink_tl-wr941-v4-16m=y

# Put the version number in the image filenames, like the official builds
# (openwrt-<version>-ath79-tiny-...). VERSION_FILENAMES sits behind VERSIONOPT,
# which is only promptable under IMAGEOPT, so all three are needed to survive
# `make defconfig`. VERSION_NUMBER/VERSION_CODE stay empty, so the version
# strings inside the image remain the release's own.
CONFIG_IMAGEOPT=y
CONFIG_VERSIONOPT=y
CONFIG_VERSION_FILENAMES=y

# Web UI.
CONFIG_PACKAGE_luci=y

# LuCI over HTTPS. libustream-mbedtls gives uhttpd its TLS backend; px5g-mbedtls
# generates the self-signed cert on first boot. Baked into the image rather than
# installed live, so a future sysupgrade can't drop them and silently break
# HTTPS.
CONFIG_PACKAGE_libustream-mbedtls=y
CONFIG_PACKAGE_px5g-mbedtls=y

# Deterministic kernel banner (uname -a). Without these the kernel embeds the
# build-time user@hostname, which in a container is a random container ID, so
# CI and local builds of the same tag differ. Same values the official
# buildbots use.
CONFIG_KERNEL_BUILD_USER="builder"
CONFIG_KERNEL_BUILD_DOMAIN="buildhost"

# Ed25519 keys in dropbear: the ath79/tiny default leaves the key type out, so
# an ed25519 client key would be rejected.
CONFIG_DROPBEAR_ED25519=y
