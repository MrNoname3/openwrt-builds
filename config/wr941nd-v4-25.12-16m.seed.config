# Seed config for OpenWRT 25.12 -> custom 16MB TL-WR941ND v4 (ath79 / tiny).
#
# !! Intended ONLY for the FUTURE 64MB-RAM build. 25.12 uses kernel 6.12 (heavier
# than 24.10's 6.6) and would be EVEN MORE memory-strained on the stock 32MB --
# do NOT flash this to a 32MB device. Test only after the 64MB RAM upgrade.
#
# NO zram on purpose: with 64MB there's ample RAM, so we don't spend the slow
# 400MHz CPU on swap compression (and zram backfired on 32MB anyway -- see the
# 24.10 seed comment).
CONFIG_TARGET_ath79=y
CONFIG_TARGET_ath79_tiny=y
CONFIG_TARGET_ath79_tiny_DEVICE_tplink_tl-wr941-v4-16m=y

# Web UI -- keep LuCI (matches the 24.10 build + the user's main router).
CONFIG_PACKAGE_luci=y
