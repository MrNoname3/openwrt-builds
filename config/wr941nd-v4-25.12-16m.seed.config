# Seed config for the custom 16 MB TL-WR941ND v4 (ath79/tiny); the board also
# needs the 64 MB RAM mod.
CONFIG_TARGET_ath79=y
CONFIG_TARGET_ath79_tiny=y
CONFIG_TARGET_ath79_tiny_DEVICE_tplink_tl-wr941-v4-16m=y

# Version number in the image filenames, as in official builds. All three are
# needed to survive `make defconfig` (each depends on the one above); the
# version strings inside the image stay the release's own.
CONFIG_IMAGEOPT=y
CONFIG_VERSIONOPT=y
CONFIG_VERSION_FILENAMES=y

# Web UI.
CONFIG_PACKAGE_luci=y

# LuCI over HTTPS: uhttpd's TLS backend and the generator of its self-signed
# certificate, built in so that a sysupgrade keeps them.
CONFIG_PACKAGE_libustream-mbedtls=y
CONFIG_PACKAGE_px5g-mbedtls=y

# Fixed user and host in the kernel banner (uname -a): the default embeds the
# container's random hostname, so builds of the same tag would differ.
CONFIG_KERNEL_BUILD_USER="builder"
CONFIG_KERNEL_BUILD_DOMAIN="buildhost"

# Ed25519 client keys in dropbear; the ath79/tiny default leaves them out.
CONFIG_DROPBEAR_ED25519=y
