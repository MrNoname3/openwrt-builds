# Seed config for OpenWRT 24.10 -> custom 16MB TL-WR941ND v4 (ath79 / tiny).
#
# Boots fine on the stock 32MB RAM (verified: kernel 6.6, ~25MB free at boot). SSH
# (dropbear) + ath9k WiFi + switch come from the device/profile defaults.
CONFIG_TARGET_ath79=y
CONFIG_TARGET_ath79_tiny=y
CONFIG_TARGET_ath79_tiny_DEVICE_tplink_tl-wr941-v4-16m=y

# Web UI -- KEEP LuCI (the user wants it, also in AP mode). Plenty of room on 16MB
# flash. uhttpd is light at idle; it only spikes RAM while rendering a page.
CONFIG_PACKAGE_luci=y

# zram-swap: compressed RAM swap (no flash wear). The ath79/tiny kernel ships with
# swap OFF, so CONFIG_KERNEL_SWAP must be enabled too. Defaults to MemTotal/2 (~12MB
# on 32MB); tune via uci system.zram_size_mb.
#
# !! WARNING — zram BACKFIRED on the stock 32MB RAM (observed 2026-06): on the slow
# 400MHz CPU, swapping out timing-critical hostapd pages caused swap-in STALLS ->
# watchdog reboots, MORE often than without swap (esp. with vm.swappiness raised).
# The real reboot culprit turned out to be 802.11r/FT, not memory. So for the 32MB
# device we run WITHOUT zram. These lines are kept for the FUTURE 64MB RAM build,
# where the extra headroom should let zram help (re-test there). If building for 32MB,
# comment these three out.
CONFIG_KERNEL_SWAP=y
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_zram-swap=y
