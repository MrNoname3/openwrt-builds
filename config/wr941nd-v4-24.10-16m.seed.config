# Seed config for OpenWRT 24.10 -> custom 16MB TL-WR941ND v4 (ath79 / tiny).
#
# First-boot test build: minimal, close to defaults, to maximise the chance it
# boots on the CURRENT 32MB RAM (kernel 6.6 is tight on 32MB). SSH (dropbear) +
# ath9k WiFi + switch come from the device/profile defaults. We add LuCI and trim
# packages for AP-only AFTER confirming it boots.
CONFIG_TARGET_ath79=y
CONFIG_TARGET_ath79_tiny=y
CONFIG_TARGET_ath79_tiny_DEVICE_tplink_tl-wr941-v4-16m=y
