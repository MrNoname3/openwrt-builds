# Whitespace rules for every editor; VS Code applies them through the
# recommended EditorConfig extension. https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

[{*.sh,*.dts,Containerfile}]
indent_size = 4

# Markdown: two trailing spaces are a hard line break, so don't strip them.
[*.md]
trim_trailing_whitespace = false
