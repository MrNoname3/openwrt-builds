{
  // "Open Folder" settings; openwrt-wr941nd.code-workspace mirrors them.
  // Whitespace rules are in .editorconfig.
  "files.associations": {
    // Seeds and the ci/ pin files are KEY=value.
    "*.seed.config": "properties",
    "*.env": "properties",
    "Containerfile": "dockerfile"
  },
  // firmware/ and work/ stay visible in the explorer; their images and scratch
  // files are kept out of search and file watching.
  "search.exclude": { "firmware/**": true, "work/**": true },
  "files.watcherExclude": { "**/firmware/**": true, "**/work/**": true },
  "editor.rulers": [100]
}
