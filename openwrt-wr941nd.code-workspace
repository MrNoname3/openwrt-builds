{
  // Portable VS Code workspace. Clone the repo anywhere and open this file
  // ("File > Open Workspace from File…") — everything below uses relative paths,
  // so it just works, with no machine-specific settings baked in. Mirrors
  // .vscode/settings.json and .vscode/extensions.json (used for "Open Folder");
  // whitespace rules live in .editorconfig.
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    // Seeds and the ci/ pin files are KEY=value.
    "files.associations": {
      "*.seed.config": "properties",
      "*.env": "properties",
      "Containerfile": "dockerfile"
    },
    // firmware/ and work/ stay visible in the explorer; their images and
    // scratch files are kept out of search and file watching.
    "search.exclude": { "firmware/**": true, "work/**": true },
    "files.watcherExclude": { "**/firmware/**": true, "**/work/**": true },
    "editor.rulers": [100]
  },
  "extensions": {
    // Offered on open so a fresh machine gets the same linting the CI enforces:
    // EditorConfig applies .editorconfig, shellcheck lints scripts, YAML +
    // GitHub Actions cover the workflows.
    "recommendations": [
      "editorconfig.editorconfig",
      "timonwong.shellcheck",
      "redhat.vscode-yaml",
      "github.vscode-github-actions"
    ]
  }
}
