{
	// Portable workspace for the TL-WR941ND OpenWrt build project.
	// Uses only relative paths so it works from any clone location:
	// open this file in VS Code (File > Open Workspace from File...) and
	// everything below is set up automatically.
	"folders": [
		{
			"name": "openwrt-wr941nd",
			"path": "."
		}
	],
	"settings": {
		// firmware/ (built images, backups) stays visible but is kept out of
		// search and the file watcher so the workspace stays snappy.
		"files.exclude": {
			"**/.git": true
		},
		"search.exclude": {
			"firmware": true
		},
		"files.watcherExclude": {
			"**/firmware/**": true
		},
		// Treat the project's non-standard file types sensibly.
		"files.associations": {
			"*.seed.config": "properties",
			"Containerfile": "dockerfile"
		},
		"[shellscript]": {
			"editor.tabSize": 4,
			"editor.insertSpaces": false,
			"files.eol": "\n"
		},
		"shellcheck.enable": true
	},
	"extensions": {
		// Suggested on first open; no absolute paths, safe to share.
		"recommendations": [
			"timonwong.shellcheck",
			"foxundermoon.shell-format",
			"ms-azuretools.vscode-docker",
			"redhat.vscode-yaml"
		]
	}
}
