# Per-device build settings for CI (.github/workflows/build.yml).
#
# OPENWRT_TAG pins the exact OpenWrt release the firmware is built from. It is
# tracked by Renovate (see renovate.json), which opens a bump PR on the Gitea
# source of truth whenever a newer tag appears in the SAME series (e.g.
# v25.12.*). A series jump (e.g. v26.x) is deliberately NOT auto-PR'd -- it
# waits for approval on the dependency dashboard, because it needs a manual DTS
# review first (see the 24.10 -> 25.12 nvmem-layout change).
#
# Changing this file is what makes a build a "new version": the tag pushed by
# scripts/tag-release.sh must be "${OPENWRT_TAG}-${DEVICE_NAME}", and the
# workflow refuses to release if it is not.
OPENWRT_TAG=v25.12.5

# Seed config under config/ used for this device's build.
SEED_FILE=wr941nd-v4-25.12-16m.seed.config

# Short device id used in artifact and release names.
DEVICE_NAME=wr941nd-v4-16m
