# Build settings for one device, read by scripts/build.sh and the CI.
#
# OPENWRT_TAG is the OpenWrt release to build and OPENWRT_COMMIT the commit it
# must resolve to; both builds refuse a tree whose HEAD differs. Renovate
# updates the pair, and its pattern expects OPENWRT_COMMIT on the next line.
# A release is tagged "${OPENWRT_TAG}-${DEVICE_NAME}" (scripts/tag-release.sh).
OPENWRT_TAG=v25.12.5
OPENWRT_COMMIT=f0a60eee2fe051741c643ea6118718aae1ef17fb

# Seed config under config/ used for this device's build.
SEED_FILE=wr941nd-v4-25.12-16m.seed.config

# Short device id used in artifact and release names.
DEVICE_NAME=wr941nd-v4-16m
