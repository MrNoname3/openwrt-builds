# Per-device build settings for CI (.github/workflows/build.yml).
#
# OPENWRT_TAG pins the exact OpenWrt release the firmware is built from. It is
# bumped automatically by the check-openwrt-release workflow, which opens a PR
# whenever a newer tag appears in the SAME series (e.g. v25.12.*). A series
# jump (e.g. v26.x) is deliberately NOT auto-bumped -- it needs a manual DTS
# review first (see the 24.10 -> 25.12 nvmem-layout change).
OPENWRT_TAG=v25.12.4

# Seed config under config/ used for this device's build.
SEED_FILE=wr941nd-v4-25.12-16m.seed.config

# Short device id used in artifact and release names.
DEVICE_NAME=wr941nd-v4-16m
