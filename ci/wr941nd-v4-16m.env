# Build settings for one device, read by scripts/build.sh and the CI.
# OPENWRT_COMMIT is the commit OPENWRT_TAG must resolve to. Renovate updates the
# pair and expects OPENWRT_COMMIT on the line right after OPENWRT_TAG.
OPENWRT_TAG=v25.12.6
OPENWRT_COMMIT=64900e756efa667774214f9c6b17c113222e01f7

# Seed config under config/ used for this device's build.
SEED_FILE=wr941nd-v4-25.12-16m.seed.config

# Device id in artifact names and the release tag (<OPENWRT_TAG>-<DEVICE_NAME>).
DEVICE_NAME=wr941nd-v4-16m
