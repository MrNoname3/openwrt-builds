# --- Device-unique data and build output: never committed ---

# Flash dumps (the unit's MAC in u-boot, its WiFi calibration in art) and the
# images built from them. The directory itself is kept so a fresh clone shows
# where they go.
firmware/*
!firmware/.gitkeep

# Private secret-scan patterns read by scripts/check.sh (hostnames, addresses).
.secret-patterns.local

# --- Local / tooling junk ---
.claude/
*.log
*.swp
.DS_Store

# Scratch files (see AGENTS.md); the directory itself is kept.
work/*
!work/.gitkeep
